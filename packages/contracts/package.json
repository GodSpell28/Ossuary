{
  "name": "@ossuary/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "export-abi": "hardhat build && node scripts/export-abi.ts",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "balance:fuji": "hardhat run scripts/balance.ts --network fuji",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network avalanche",
    "balance:mainnet": "hardhat run scripts/balance.ts --network avalanche",
    "verify:fuji": "hardhat verify sourcify --network fuji"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "hardhat": "^3.18.1",
    "typescript": "^7.0.2",
    "viem": "^2.57.3"
  }
}
